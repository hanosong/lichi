{
  "name": "test",
  "version": "1.0.0",
  "description": "宠物零食标签管理与易联云云端打印系统",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --watch-path=./server --watch-preserve-output server/index.js",
    "import:labels": "node scripts/import-labels.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/print-format.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yly-nodejs-sdk": "^2.0.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "mammoth": "^1.12.1",
    "vite": "^5.4.21"
  }
}
